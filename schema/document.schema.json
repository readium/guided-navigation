{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://readium.org/guided-navigation/schema/document.schema.json",
  "title": "Readium Guided Navigation Document",
  "type": "object",
  "properties": {
    "guided": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1
    }
  },
  "required": [
    "guided"
  ],
  "$defs": {
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "audioref": {
          "type": "string",
          "format": "uri-reference"
        },
        "imgref": {
          "type": "string",
          "format": "uri-reference"
        },
        "textref": {
          "type": "string",
          "format": "uri-reference"
        },
        "videoref": {
          "type": "string",
          "format": "uri-reference"
        },
        "text": {
          "$ref": "text.schema.json"
        },
        "role": {
          "type": ["array"],
          "items": {
            "type": "string",
            "$ref": "roles.schema.json"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "object.schema.json"
          },
          "minItems": 1
        },
        "description" : {
          "$ref": "description.schema.json"
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": ["audioref"]
        },
        {
          "required": ["imgref"]
        },
        {
          "required": ["textref"]
        },
        {
          "required": ["videoref"]
        },
        {
          "required": ["text"]
        },
        {
          "required": ["children"]
        }
      ],
      "allOf": [
        {
          "$comment": "colspan/rowspan are only meaningful on cell, columnheader, or rowheader roles",
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "type": "array",
                "contains": { "enum": ["cell", "columnheader", "rowheader"] }
              }
            }
          },
          "then": true,
          "else": {
            "allOf": [
              { "not": { "required": ["colspan"] } },
              { "not": { "required": ["rowspan"] } }
            ]
          }
        }
      ]
    }
  }
}